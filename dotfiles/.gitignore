#
# .gitignore
#

*.o
*.o.*
*.a
*.ko
*.so.dbg
*.mod.c
*.i
*.lst
*.symtypes
*.order
*.elf
*.bin
*.gz
*.lzma
*.patch
*.gcno

# stgit generated dirs
patches-*

# quilt's files
patches
series

# cscope files
cscope.*
ncscope.*
!cscope.vim

# gnu global files
GPATH
GRTAGS
GSYMS
GTAGS

tags
tags.lock
tags.temp

*.orig
*~
\#*#

.terraform/

.envrc

# Claude Code local settings
.claude/settings.local.json

# Pi runtime state. Track only the reviewed, non-secret Pi configuration.
!.pi/
.pi/*
!.pi/agent/
.pi/agent/*
!.pi/agent/mcp.json
!.pi/agent/permissions.json
!.pi/agent/settings.json
!.pi/agent/settings.github-copilot-codex.json
!.pi/agent/settings.codex-opencode-go.json
